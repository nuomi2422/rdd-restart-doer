# ── 密钥/凭证：PCL 等启动器生成物内含 accessToken + uuid ──
rdd-selfcompile/instances/
*.cmd
# stager.bat 依赖 bin/stager.cmd，白名单放行（否则新克隆必报「folder is broken」）
!stager/bin/stager.cmd
# packaging 的离线编译启动器也是要跟版本的脚本，白名单放行
!packaging/templates/build-offline.cmd

# ── 离线 Gradle 发行版（307 个 lib 文件）──
gradle-9.2.0/

# ── 验证用浏览器 profile（含缓存/cookie/扩展）──
_verify/

# ── 构建产物 ──
build/
.gradle/
node_modules/

# ── 变异临时工作区（每次任务的临时改动，已进 git 的源码才是真源）──
rdd-selfcompile/mutations/

# ── stager 运行态（任务/文档/锁）──
.stager/

# ── 持续 churn 的本机运行时文件（曾每个提交都带 4 行，纯噪音）──
# 桌宠窗口坐标 + 用户手动指定的表情覆盖（本机 UI 状态，不是源码）
stager/pet/pet-pos.json
# 看门狗 / 心跳 / 驱动 / 开机自启的滚动日志（内容已留在历史里，文件本身不必跟版）
*.log

# ── 敏感配置（本机密钥，改码本地的 config 不入库）──
config/*.json
rdd-selfcompile/instances/
# AI Bridge MCP token（2026-10-03 从 start-ai-bridge.ps1 里移出，那行曾被提交）
rdd-selfcompile/scripts/ai-bridge.token

# ── 套娃仓库（各自有 .git，提交只会存成一个「gitlink」指针，
#    克隆外层仓库时拿不到内容，反而误导）──
minecraft-numen/
rdd-monitor-publish-20260913/
mc-openclaw-controller/
voyager/
rdd-selfcompile/ai-bridge/
# 第 7 个套娃仓库：ACX 的仓外副本（含唯一一份 ACX 测试，暂不删但必须忽略）
ac-upgrade/
*.zip

# ── 垃圾/草稿（2026-10-03 批0清理：防再入库）──
*.bak
msg-*.txt
rdd-selfcompile/report/w-replies/
rdd-selfcompile/scripts/_w-shots/
rdd-selfcompile/scripts/task-efficiency*.jsonl
rdd-selfcompile/scripts/*.state.*.json

# ── 本机启动脚本（含绝对路径/端口，按需留）──
# autostart-dev.ps1 已在库；下面这几个只给本机用
# Startup/

# ── checkpoint 快照（2026-10-18 清理：85MB 本机数据快照不当源码入库）──
checkpoint-*/
AGENTS.backup/

# ── 临时产物（2026-10-21 清账时发现未跟踪）────────────────────────────
# .tmp/ 是会话临时脚本/探针/解包（AGENTS.md 里写明「随便改，可删」）；
# .tmp-agents-msg.txt 是一次性消息草稿。两者都属运行产物，不该入库。
.tmp/
.tmp-*

# ── 存档快照（P15 工具产物，30MB 级，不进 git；用完 --prune 删）──
rdd-selfcompile/snapshots/

# ── report 下的一次性探针/取证产物（2026-10-29 清账：125 项未跟踪里 97% 是这些）──
# 为什么排：它们让 `git status` 永远淹在 125 行里，真正的台账/脚本看不见，
# 而 `git add -A` 一按就全卷进去（已出过两次事故）。
# ★ 明确不排：deploy-ledger.jsonl（append-only 台账）、review-packs/、review-requests/、
#   *.md（取证文档）、scripts/ 下可复现的启动脚本与 verify-tools。
rdd-selfcompile/report/args-*.json
rdd-selfcompile/report/start*.err
rdd-selfcompile/report/start*.log.err
rdd-selfcompile/report/*.log.err
rdd-selfcompile/report/javap-*.txt
rdd-selfcompile/report/watch-*.js
rdd-selfcompile/report/observer-*
rdd-selfcompile/report/observe-*
rdd-selfcompile/report/exp-entry-*.json
rdd-selfcompile/report/goal*.json
rdd-selfcompile/report/bot-test.js
# 一次性补丁/扫描脚本（改完即弃；要留就搬进 verify-tools 并带 --help 与自测）
rdd-selfcompile/report/fix-triggers.js
rdd-selfcompile/report/patch-*.ps1
rdd-selfcompile/report/scan-*.ps1

# ── 2026-11-03 清账：本机工作树副本与运行态 ──
# numen-audit-wt/ 是审计 worktree，numen-clean/ 是 463MB 的干净副本，都不是源码
numen-audit-wt/
numen-clean/
# stager 每日/采纳曲线是运行数据
stager/runs/
# 启动期 stderr（几乎全为 0 字节）与 OC 消息草稿
rdd-selfcompile/report/*.err
rdd-selfcompile/msg*.json

# ── 2026-11-07 补齐：别的仓的 worktree / 离线打包产物，本仓不该跟踪 ──
# 为什么：这些目录不是本仓的文件，而是 minecraft-numen / rdd-harness 两个仓的合法 worktree
#   （git -C minecraft-numen worktree list 可查），外加离线打包产物；本仓跟踪它们只会让 git status 永远脏。
# 做法：只加忽略、不删任何目录 —— 并行窗口正在这些工作树里干活，删了会砸别人的活。
# 案例：2026-11-03 已用同一办法忽略 minecraft-numen/、rdd-monitor-publish-*、numen-audit-wt/、numen-clean/；
#   后来新增的 wt 命名没跟上，导致 P14「工作区干净」长期红（同 P10 教训：门禁一直红=等于没有）。
minecraft-numen-wt-*/
numen-context-wt/
harness-context-wt/
packaging/world-context-core-*/
rdd-selfcompile/backups/
