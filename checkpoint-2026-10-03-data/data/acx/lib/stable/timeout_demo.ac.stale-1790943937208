{
  "name": "timeout_demo",
  "version": "1",
  "description": "故意空转：limits.max_timeout_ms=300，跑到墙钟就 TIMEOUT。用来验第 4 个终态不是字符串匹配。",
  "tags": [
    "demo",
    "limits"
  ],
  "planner_notes": "max_steps 提到 100000 是为了让「步数熔断」不先于「时间熔断」触发，否则测的是步数不是超时。",
  "safety_notes": "纯读状态，不动世界。",
  "limits": {
    "max_timeout_ms": 300,
    "max_steps": 100000
  },
  "steps": [
    {
      "id": "spin",
      "block": "while",
      "params": {
        "condition": {
          "field": "$input.keep",
          "op": "==",
          "value": true
        },
        "max_iters": 1000000,
        "stagnant_limit": 1000000
      },
      "children": [
        {
          "id": "tick",
          "block": "get_self_status",
          "params": {}
        }
      ]
    },
    {
      "id": "after",
      "block": "get_self_status",
      "params": {}
    }
  ]
}
